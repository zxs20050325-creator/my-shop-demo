# ============================================================
# 本地开发环境变量模板
# 复制为 .env 后填入真实值：cp .env.example .env
# .env 已被 .gitignore 忽略，切勿提交
# ============================================================

# ---- Supabase ----
# Supabase Dashboard → Project Settings → API → Project URL
SUPABASE_URL=https://your-project-ref.supabase.co

# service_role 密钥（后端专用！）
# Supabase Dashboard → Project Settings → API → Project API keys → service_role
# （点 Reveal 才可见，很长一串 JWT）
#
# ⚠️ 不要复制成 anon public 那个 —— 两者在同一区域，极易看错。
# ⚠️ 这是全权密钥，会绕过 RLS。只能存在于服务端，绝不能提交进 git，
#    也绝不能出现在任何前端代码或浏览器可见的响应里。
SUPABASE_SERVICE_KEY=请替换为真实的-service_role-密钥

# 后端服务端口（可选，默认 3000）
PORT=3000

# 管理员口令（访问 /api/admin/* 后台接口时需要，默认 admin123）
ADMIN_PASSWORD=admin123
